<Project Sdk="Microsoft.NET.Sdk">

  <!--
    KSP 1.12 mod: a .NET Framework 4.8 class library built with the .NET SDK (no Visual Studio needed).
    The KSP assemblies come from the install named by KSPDIR (an environment variable, or -p:KSPDIR=<path>);
    on CI it is the KSPModdingLibs archive, which has the same KSP_x64_Data/Managed layout.
    With KSPDIR set, a build also copies the DLL and its pdb into GameData/ModularFlightIntegrator there.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ModularFlightIntegrator</AssemblyName>
    <RootNamespace>ModularFI</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <KspManaged>$(KSPDIR)/KSP_x64_Data/Managed</KspManaged>
  </PropertyGroup>

  <ItemGroup>
    <!-- the .NET Framework reference assemblies, so the build needs no targeting pack and works on Linux -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Example.cs is documentation for mod authors; the license and version template ship in the package -->
    <Compile Remove="Example.cs" />
    <None Include="Example.cs" />
    <Compile Remove="ModularFlightIntegrator/**" />
    <None Include="ModularFlightIntegrator/**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KspManaged)/Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(KspManaged)/UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KspManaged)/UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToKsp" AfterTargets="Build" Condition="'$(KSPDIR)' != ''">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(KSPDIR)/GameData/ModularFlightIntegrator" ContinueOnError="true" />
  </Target>

</Project>
